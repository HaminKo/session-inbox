{
  "name": "session-inbox",
  "displayName": "Session Inbox",
  "description": "A persistent \"waiting on you\" inbox for Claude Code sessions across VS Code windows.",
  "version": "0.0.1",
  "publisher": "session-inbox",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "notifications",
    "status bar",
    "inbox"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionInbox",
          "title": "Session Inbox",
          "icon": "media/inbox.svg"
        }
      ]
    },
    "views": {
      "sessionInbox": [
        {
          "id": "sessionInbox.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionInbox.groupByProject",
        "title": "Group by project",
        "category": "Session Inbox",
        "icon": "$(folder)"
      },
      {
        "command": "sessionInbox.groupByState",
        "title": "Group by state",
        "category": "Session Inbox",
        "icon": "$(layers)"
      },
      {
        "command": "sessionInbox.openSession",
        "title": "Open session's window",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.setProjectIcon",
        "title": "Set Icon…",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.resetProjectIcon",
        "title": "Reset Icon",
        "category": "Session Inbox"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionInbox.groupByProject",
          "when": "view == sessionInbox.sessions && sessionInbox.groupBy != project",
          "group": "navigation"
        },
        {
          "command": "sessionInbox.groupByState",
          "when": "view == sessionInbox.sessions && sessionInbox.groupBy == project",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionInbox.groupByProject",
          "when": "false"
        },
        {
          "command": "sessionInbox.groupByState",
          "when": "false"
        },
        {
          "command": "sessionInbox.openSession",
          "when": "false"
        },
        {
          "command": "sessionInbox.setProjectIcon",
          "when": "false"
        },
        {
          "command": "sessionInbox.resetProjectIcon",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionInbox.setProjectIcon",
          "when": "view == sessionInbox.sessions && viewItem == project",
          "group": "1_look@1"
        },
        {
          "command": "sessionInbox.resetProjectIcon",
          "when": "view == sessionInbox.sessions && viewItem == project",
          "group": "1_look@2"
        }
      ]
    },
    "configuration": {
      "title": "Session Inbox",
      "properties": {
        "sessionInbox.renotifyMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "Minutes a session may wait on you (a permission prompt or a question) before its popup is shown once more. `0` turns reminders off. Uses `~/.claude/hooks/notify.ps1`."
        },
        "sessionInbox.projects": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "markdownDescription": "A [codicon](https://code.visualstudio.com/api/references/icons-in-labels#icon-listing) name, e.g. `map`."
              }
            }
          },
          "markdownDescription": "A project's own icon in the sidebar when grouped by project, keyed by the project's name (case ignored), e.g. `{ \"sc-map-library\": { \"icon\": \"map\" } }`. The icon keeps its state colour. Set by right-clicking a project header."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "sessionInbox.sessions",
        "contents": "No Claude Code sessions running."
      }
    ]
  },
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "compile": "npm run bundle -- --sourcemap",
    "watch": "npm run bundle -- --sourcemap --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "test:gui": "npm run compile && node --test --test-concurrency=1 \"test/gui/*.gui.ts\"",
    "screenshots": "npm run compile && node test/gui/screenshots.ts",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run bundle -- --minify",
    "test": "node --test \"test/unit/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~20.17.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
