{
  "name": "session-inbox",
  "displayName": "Session Inbox",
  "description": "A persistent \"waiting on you\" inbox for Claude Code sessions across VS Code windows.",
  "version": "0.1.0",
  "publisher": "session-inbox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaminKo/session-inbox",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude code",
    "notifications",
    "status bar",
    "inbox"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionInbox",
          "title": "Session Inbox",
          "icon": "media/inbox.svg"
        }
      ]
    },
    "views": {
      "sessionInbox": [
        {
          "id": "sessionInbox.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionInbox.groupByProject",
        "title": "Group by project",
        "category": "Session Inbox",
        "icon": "$(folder)"
      },
      {
        "command": "sessionInbox.groupByState",
        "title": "Group by state",
        "category": "Session Inbox",
        "icon": "$(layers)"
      },
      {
        "command": "sessionInbox.openSession",
        "title": "Open session's window",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.setProjectIcon",
        "title": "Set Icon…",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.resetProjectIcon",
        "title": "Reset Icon",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.setProjectStatus",
        "title": "Set Project Status…",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.setProjectStatusColor",
        "title": "Set Status Color…",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.clearProjectStatus",
        "title": "Clear Project Status",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.setWindowProjectStatus",
        "title": "Set Status of This Project…",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.openProject",
        "title": "Open project's window",
        "category": "Session Inbox"
      },
      {
        "command": "sessionInbox.installHooks",
        "title": "Install Hooks",
        "category": "Session Inbox"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionInbox.groupByProject",
          "when": "view == sessionInbox.sessions && sessionInbox.groupBy != project",
          "group": "navigation"
        },
        {
          "command": "sessionInbox.groupByState",
          "when": "view == sessionInbox.sessions && sessionInbox.groupBy == project",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionInbox.groupByProject",
          "when": "false"
        },
        {
          "command": "sessionInbox.groupByState",
          "when": "false"
        },
        {
          "command": "sessionInbox.openSession",
          "when": "false"
        },
        {
          "command": "sessionInbox.setProjectIcon",
          "when": "false"
        },
        {
          "command": "sessionInbox.resetProjectIcon",
          "when": "false"
        },
        {
          "command": "sessionInbox.setProjectStatus",
          "when": "false"
        },
        {
          "command": "sessionInbox.setProjectStatusColor",
          "when": "false"
        },
        {
          "command": "sessionInbox.clearProjectStatus",
          "when": "false"
        },
        {
          "command": "sessionInbox.openProject",
          "when": "false"
        },
        {
          "command": "sessionInbox.setWindowProjectStatus",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionInbox.setProjectStatus",
          "when": "view == sessionInbox.sessions && viewItem =~ /^(project|session|closed)/",
          "group": "0_status@1"
        },
        {
          "command": "sessionInbox.setProjectStatusColor",
          "when": "view == sessionInbox.sessions && viewItem =~ /[.]status$/",
          "group": "0_status@2"
        },
        {
          "command": "sessionInbox.clearProjectStatus",
          "when": "view == sessionInbox.sessions && viewItem =~ /[.]status$/",
          "group": "0_status@3"
        },
        {
          "command": "sessionInbox.setProjectIcon",
          "when": "view == sessionInbox.sessions && viewItem =~ /^project/",
          "group": "1_look@1"
        },
        {
          "command": "sessionInbox.resetProjectIcon",
          "when": "view == sessionInbox.sessions && viewItem =~ /^project/",
          "group": "1_look@2"
        }
      ]
    },
    "configuration": {
      "title": "Session Inbox",
      "properties": {
        "sessionInbox.renotifyMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "Minutes a session may wait on you (a permission prompt or a question) before its popup is shown once more. `0` turns reminders off. Needs your own popup hook at `~/.claude/hooks/notify.ps1` (not included)."
        },
        "sessionInbox.trayIcon": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Show the number of sessions that need you in the Windows system tray, next to the clock, also when no VS Code window is in front. Click it for the list; a session opens its window. Closes with VS Code."
        },
        "sessionInbox.projects": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "markdownDescription": "A [codicon](https://code.visualstudio.com/api/references/icons-in-labels#icon-listing) name, e.g. `map`."
              },
              "focus": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "const": false
                  }
                ],
                "markdownDescription": "The markdown file in the project folder whose `## Where we are` section gives the `Now:` row under the project's header when grouped by project. Default `docs/todo.md`, so only a project that keeps it elsewhere needs this; `false` shows no row."
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "markdownDescription": "A status set by hand, e.g. `On hold`, shown after the project's name. The project stays listed (as **Closed**) when no chat of it runs. Set or clear it by right-clicking the project."
              },
              "statusColor": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*([.][A-Za-z][A-Za-z0-9]*)*$",
                "markdownDescription": "The color of the project's name and status in the sidebar: a [theme color](https://code.visualstudio.com/api/references/theme-color) id, e.g. `charts.purple` (not a hex code). Set it by right-clicking the project: **Set Status Color…**."
              },
              "folder": {
                "type": "string",
                "minLength": 1,
                "markdownDescription": "The project's folder, saved with its status, so its **Closed** row can open it."
              }
            }
          },
          "markdownDescription": "A project's own icon, focus file and status in the sidebar, keyed by the project's name (case ignored), e.g. `{ \"sc-map-library\": { \"icon\": \"map\" } }`. The focus row comes from each project's `docs/todo.md` without a setting. The icon keeps its state colour; set it, and the status, by right-clicking a project header."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "sessionInbox.sessions",
        "contents": "No Claude Code sessions running."
      }
    ]
  },
  "scripts": {
    "bundle": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true});require('node:fs').copyFileSync('../hooks/session-status.ps1','dist/session-status.ps1');require('node:fs').copyFileSync('../tray/session-tray.ps1','dist/session-tray.ps1')\" && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "compile": "npm run bundle -- --sourcemap",
    "watch": "npm run bundle -- --sourcemap --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "test:gui": "npm run compile && node --test --test-concurrency=1 \"test/gui/*.gui.ts\"",
    "screenshots": "npm run compile && node test/gui/screenshots.ts",
    "package": "vsce package",
    "vscode:prepublish": "node -e \"require('node:fs').copyFileSync('../CHANGELOG.md','CHANGELOG.md')\" && npm run bundle -- --minify",
    "test": "node --test \"test/unit/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~20.17.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
