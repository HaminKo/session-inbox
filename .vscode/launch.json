{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Session Inbox extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--disable-extensions", "--extensionDevelopmentPath=${workspaceFolder}/extension"],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "Build extension"
    }
  ]
}
