{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Type-check extension",
      "type": "npm",
      "script": "check-types",
      "path": "extension",
      "problemMatcher": {
        "base": "$tsc",
        "fileLocation": ["relative", "${workspaceFolder}/extension"]
      }
    },
    {
      "label": "Build extension",
      "type": "npm",
      "script": "compile",
      "path": "extension",
      "dependsOn": "Type-check extension",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
